generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String         @id @default(cuid())
  email                 String         @unique
  name                  String?
  password              String?
  avatarUrl             String?
  emailVerified         DateTime?
  status                UserStatus     @default(ACTIVE)
  lastLoginAt           DateTime?
  roleId                String
  lazId                 String
  isPlatformAdmin       Boolean        @default(false)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  avatarPublicId        String?
  emailNotifications    Boolean        @default(true)
  phoneNumber           String?
  waNotifications       Boolean        @default(true)
  auditLogs             AuditLog[]
  distributionsApproved Distribution[] @relation("DistributionApprover")
  distributionsCreated  Distribution[] @relation("DistributionCreator")
  donations             Donation[]
  programs              Program[]
  laz                   Laz            @relation(fields: [lazId], references: [id], onDelete: Cascade)
  role                  Role           @relation(fields: [roleId], references: [id])

  @@map("users")
}

model Laz {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  logoUrl       String?
  logoPublicId  String?
  status        String         @default("ACTIVE")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  auditLogs     AuditLog[]
  distributions Distribution[]
  donations     Donation[]
  payments      Payment[]
  programs      Program[]
  users         User[]

  @@map("lazs")
}

model Role {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  users           User[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(cuid())
  key             String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  lazId     String?
  action    AuditAction
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())
  laz       Laz?        @relation(fields: [lazId], references: [id])
  user      User?       @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Program {
  id                String          @id @default(cuid())
  lazId             String
  createdById       String
  title             String
  slug              String
  description       String
  targetAmount      Decimal         @db.Decimal(12, 2)
  currentAmount     Decimal         @default(0) @db.Decimal(12, 2)
  distributedAmount Decimal         @default(0) @db.Decimal(12, 2)
  category          ProgramCategory
  status            ProgramStatus   @default(DRAFT)
  imageUrl          String?
  startDate         DateTime?
  endDate           DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  distributions     Distribution[]
  donations         Donation[]
  createdBy         User            @relation(fields: [createdById], references: [id])
  laz               Laz             @relation(fields: [lazId], references: [id], onDelete: Cascade)

  @@unique([lazId, slug])
  @@map("programs")
}

model Donation {
  id          String         @id @default(cuid())
  lazId       String
  programId   String
  userId      String?
  donorName   String?
  donorEmail  String?
  donorPhone  String?
  amount      Decimal        @db.Decimal(12, 2)
  message     String?
  isAnonymous Boolean        @default(false)
  status      DonationStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  laz         Laz            @relation(fields: [lazId], references: [id], onDelete: Cascade)
  program     Program        @relation(fields: [programId], references: [id])
  user        User?          @relation(fields: [userId], references: [id])
  payment     Payment?

  @@map("donations")
}

model Payment {
  id            String        @id @default(cuid())
  lazId         String
  donationId    String        @unique
  gatewayRef    String?       @unique
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod String?
  status        PaymentStatus @default(PENDING)
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  donation      Donation      @relation(fields: [donationId], references: [id], onDelete: Cascade)
  laz           Laz           @relation(fields: [lazId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Distribution {
  id              String             @id @default(cuid())
  lazId           String
  programId       String
  createdById     String
  approvedById    String?
  amount          Decimal            @db.Decimal(12, 2)
  title           String
  description     String
  receiptImageUrl String?
  status          DistributionStatus @default(PENDING)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  approvedBy      User?              @relation("DistributionApprover", fields: [approvedById], references: [id])
  createdBy       User               @relation("DistributionCreator", fields: [createdById], references: [id])
  laz             Laz                @relation(fields: [lazId], references: [id], onDelete: Cascade)
  program         Program            @relation(fields: [programId], references: [id])

  @@map("distributions")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum DonationStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  EXPIRED
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  ROLE_CHANGE
  PAYMENT_UPDATE
  DISTRIBUTION_UPDATE
}

enum ProgramCategory {
  ZAKAT
  INFAK
  SEDEKAH
  WAKAF
}

enum ProgramStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}

enum DistributionStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}
