// ─────────────────────────────────────────
// GENERATOR & DATASOURCE
// ─────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum DonationStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  EXPIRED
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  ROLE_CHANGE
  PAYMENT_UPDATE
  DISTRIBUTION_UPDATE
}

enum ProgramCategory {
  ZAKAT
  INFAK
  SEDEKAH
  WAKAF
}

enum ProgramStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}

enum DistributionStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

// ─────────────────────────────────────────
// PLATFORM USERS (GLOBAL RBAC)
// ─────────────────────────────────────────

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  name           String?
  password       String?
  avatarUrl      String?
  emailVerified  DateTime?
  phoneNumber    String?
  status         UserStatus @default(ACTIVE)
  lastLoginAt    DateTime?

  emailNotifications Boolean @default(true)
  waNotifications    Boolean @default(true)

  roleId         String

  // tenant scope
  lazId          String

  // platform admin override (Kitabisa internal ops)
  isPlatformAdmin Boolean @default(false)

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  role      Role  @relation(fields: [roleId], references: [id])
  laz       Laz   @relation(fields: [lazId], references: [id], onDelete: Cascade)

  auditLogs AuditLog[]

  donations  Donation[]
  programs   Program[]
  distributionsCreated Distribution[] @relation("DistributionCreator")
  distributionsApproved Distribution[] @relation("DistributionApprover")

  @@map("users")
}

// ─────────────────────────────────────────
// TENANT (LAZ)
// ─────────────────────────────────────────

model Laz {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  logoUrl       String?
  logoPublicId  String?
  status        String   @default("ACTIVE")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users         User[]
  programs      Program[]
  donations     Donation[]
  payments      Payment[]
  distributions Distribution[]
  auditLogs     AuditLog[]

  @@map("lazs")
}

// ─────────────────────────────────────────
// RBAC (GLOBAL)
// ─────────────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?

  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String

  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ─────────────────────────────────────────
// AUDIT LOG (TENANT SCOPED)
// ─────────────────────────────────────────

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  lazId     String?

  action    AuditAction
  entity    String
  entityId  String?

  oldData   Json?
  newData   Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  laz  Laz?  @relation(fields: [lazId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// ─────────────────────────────────────────
// CORE BUSINESS ENTITIES (TENANT SCOPED)
// ─────────────────────────────────────────

model Program {
  id            String   @id @default(cuid())

  lazId         String
  createdById   String

  title         String
  slug          String
  description   String   @db.Text

  targetAmount      Decimal @db.Decimal(12,2)
  currentAmount     Decimal @default(0) @db.Decimal(12,2)
  distributedAmount Decimal @default(0) @db.Decimal(12,2)

  category      ProgramCategory
  status        ProgramStatus @default(DRAFT)

  imageUrl      String?
  startDate     DateTime?
  endDate       DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  laz           Laz  @relation(fields: [lazId], references: [id], onDelete: Cascade)
  createdBy     User @relation(fields: [createdById], references: [id])

  donations     Donation[]
  distributions Distribution[]

  @@unique([lazId, slug])
  @@map("programs")
}

model Donation {
  id          String @id @default(cuid())

  lazId       String
  programId   String
  userId      String?

  amount      Decimal @db.Decimal(12,2)
  message     String?
  isAnonymous Boolean @default(false)

  status      DonationStatus @default(PENDING)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  laz     Laz @relation(fields: [lazId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Restrict)
  user    User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  payment Payment?

  @@map("donations")
}

model Payment {
  id            String @id @default(cuid())

  lazId         String
  donationId    String @unique

  gatewayRef    String? @unique
  amount        Decimal @db.Decimal(12,2)

  paymentMethod String?
  status        PaymentStatus @default(PENDING)

  metadata      Json?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  laz      Laz @relation(fields: [lazId], references: [id], onDelete: Cascade)
  donation Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Distribution {
  id           String @id @default(cuid())

  lazId        String
  programId    String

  createdById  String
  approvedById String?

  amount       Decimal @db.Decimal(12,2)
  title        String
  description  String @db.Text

  receiptImageUrl String?

  status       DistributionStatus @default(PENDING)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  laz        Laz  @relation(fields: [lazId], references: [id], onDelete: Cascade)
  program    Program @relation(fields: [programId], references: [id], onDelete: Restrict)

  createdBy  User @relation("DistributionCreator", fields: [createdById], references: [id])
  approvedBy User? @relation("DistributionApprover", fields: [approvedById], references: [id])

  @@map("distributions")
}