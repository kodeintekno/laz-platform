// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// LAZ Platform — Proper Multi-Tenant Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum DonationStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  EXPIRED
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  ROLE_CHANGE
  PAYMENT_UPDATE
  DISTRIBUTION_UPDATE
}

enum ProgramCategory {
  ZAKAT
  INFAK
  SEDEKAH
  WAKAF
}

enum ProgramStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}

enum DistributionStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

// ─────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────

model Laz {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl      String?   @map("logo_url")
  logoPublicId String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]         @relation("LazUsers")
  roles         Role[]         @relation("LazRoles")
  programs      Program[]      @relation("LazPrograms")
  donations     Donation[]     @relation("LazDonations")
  payments      Payment[]      @relation("LazPayments")
  distributions Distribution[] @relation("LazDistributions")
  auditLogs     AuditLog[]     @relation("LazAuditLogs")

  @@map("lazs")
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  name           String?
  password       String?
  avatarUrl          String?
  emailVerified  DateTime?
  status         UserStatus @default(ACTIVE)
  lastLoginAt    DateTime?
  roleId         String?
  lazId          String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  role      Role?      @relation("UserRole", fields: [roleId], references: [id])
  laz       Laz        @relation("LazUsers", fields: [lazId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[] @relation("UserAuditLogs")
  donations Donation[] @relation("UserDonations")
  programs  Program[]  @relation("ProgramCreator")
  createdDistributions  Distribution[] @relation("DistributionCreator")
  approvedDistributions Distribution[] @relation("DistributionApprover")

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String
  description String?
  lazId       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  laz             Laz              @relation("LazRoles", fields: [lazId], references: [id], onDelete: Cascade)
  users           User[]           @relation("UserRole")
  rolePermissions RolePermission[] @relation("RoleToRolePermission")

  @@unique([lazId, name])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "users.read", "programs.manage"
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[] @relation("PermissionToRolePermission")

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation("RoleToRolePermission", fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation("PermissionToRolePermission", fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  lazId     String?
  action    AuditAction
  entity    String // e.g. "User", "Program", "Donation"
  entityId  String?
  oldData   Json? // JSONB snapshot of previous state
  newData   Json? // JSONB snapshot of new state
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  user User? @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)
  laz  Laz?  @relation("LazAuditLogs", fields: [lazId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model Program {
  id            String          @id @default(cuid())
  title         String
  slug          String
  description   String          @db.Text
  targetAmount      Decimal         @db.Decimal(12, 2)
  currentAmount     Decimal         @default(0) @db.Decimal(12, 2)
  distributedAmount Decimal         @default(0) @db.Decimal(12, 2)
  category          ProgramCategory
  status            ProgramStatus   @default(DRAFT)
  imageUrl             String?
  startDate         DateTime?
  endDate           DateTime?
  createdById       String
  lazId             String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  createdBy     User           @relation("ProgramCreator", fields: [createdById], references: [id])
  laz           Laz            @relation("LazPrograms", fields: [lazId], references: [id], onDelete: Cascade)
  donations     Donation[]     @relation("ProgramDonations")
  distributions Distribution[] @relation("ProgramDistributions")

  @@unique([lazId, slug])
  @@map("programs")
}

model Donation {
  id          String         @id @default(cuid())
  amount      Decimal        @db.Decimal(12, 2)
  message     String?
  isAnonymous Boolean        @default(false)
  status      DonationStatus @default(PENDING)
  userId      String?
  programId   String
  lazId       String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user    User?    @relation("UserDonations", fields: [userId], references: [id], onDelete: SetNull)
  program Program  @relation("ProgramDonations", fields: [programId], references: [id], onDelete: Restrict)
  payment Payment? @relation("DonationPayment")
  laz     Laz      @relation("LazDonations", fields: [lazId], references: [id], onDelete: Cascade)

  @@map("donations")
}

model Payment {
  id            String        @id @default(cuid())
  donationId    String        @unique
  gatewayRef    String?       @unique
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod String?
  status        PaymentStatus @default(PENDING)
  metadata      Json?
  lazId         String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  donation Donation @relation("DonationPayment", fields: [donationId], references: [id], onDelete: Cascade)
  laz      Laz      @relation("LazPayments", fields: [lazId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Distribution {
  id           String             @id @default(cuid())
  programId    String
  amount       Decimal            @db.Decimal(12, 2)
  title        String
  description  String             @db.Text
  receiptImageUrl String?
  status       DistributionStatus @default(PENDING)
  createdById  String
  approvedById String?
  lazId        String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  program    Program @relation("ProgramDistributions", fields: [programId], references: [id], onDelete: Restrict)
  createdBy  User    @relation("DistributionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User?   @relation("DistributionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  laz        Laz     @relation("LazDistributions", fields: [lazId], references: [id], onDelete: Cascade)

  @@map("distributions")
}
