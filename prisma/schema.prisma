// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// LAZ Platform — Phase 1: Foundation Schema
// Stub models and enums only. Relations and full fields added per phase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url = env("DATABASE_URL") // moved to prisma/config.ts
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum DonationStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  EXPIRED
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  ROLE_CHANGE
  PAYMENT_UPDATE
  DISTRIBUTION_UPDATE
}

enum ProgramCategory {
  ZAKAT
  INFAK
  SEDEKAH
  WAKAF
}

enum ProgramStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}

enum DistributionStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

// ─────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  name           String?
  password       String?
  image          String?
  emailVerified  DateTime?
  status         UserStatus @default(ACTIVE)
  lastLoginAt    DateTime?
  roleId         String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  role      Role?      @relation("UserRole", fields: [roleId], references: [id])
  auditLogs AuditLog[] @relation("UserAuditLogs")
  donations Donation[] @relation("UserDonations")
  programs  Program[]  @relation("ProgramCreator")
  createdDistributions  Distribution[] @relation("DistributionCreator")
  approvedDistributions Distribution[] @relation("DistributionApprover")

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           User[]           @relation("UserRole")
  rolePermissions RolePermission[] @relation("RoleToRolePermission")

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "users.read", "programs.manage"
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[] @relation("PermissionToRolePermission")

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation("RoleToRolePermission", fields: [roleId], references: [id])
  permission Permission @relation("PermissionToRolePermission", fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  action    AuditAction
  entity    String // e.g. "User", "Program", "Donation"
  entityId  String?
  oldData   Json? // JSONB snapshot of previous state
  newData   Json? // JSONB snapshot of new state
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  user User? @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model Program {
  id            String          @id @default(cuid())
  title         String
  slug          String          @unique
  description   String          @db.Text
  targetAmount      Decimal         @db.Decimal(12, 2)
  currentAmount     Decimal         @default(0) @db.Decimal(12, 2)
  distributedAmount Decimal         @default(0) @db.Decimal(12, 2)
  category          ProgramCategory
  status            ProgramStatus   @default(DRAFT)
  image             String?
  startDate         DateTime?
  endDate           DateTime?
  createdById       String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  createdBy     User           @relation("ProgramCreator", fields: [createdById], references: [id])
  donations     Donation[]     @relation("ProgramDonations")
  distributions Distribution[] @relation("ProgramDistributions")

  @@map("programs")
}

model Donation {
  id          String         @id @default(cuid())
  amount      Decimal        @db.Decimal(12, 2)
  message     String?
  isAnonymous Boolean        @default(false)
  status      DonationStatus @default(PENDING)
  userId      String?
  programId   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user    User?    @relation("UserDonations", fields: [userId], references: [id], onDelete: SetNull)
  program Program  @relation("ProgramDonations", fields: [programId], references: [id], onDelete: Restrict)
  payment Payment? @relation("DonationPayment")

  @@map("donations")
}

model Payment {
  id            String        @id @default(cuid())
  donationId    String        @unique
  gatewayRef    String?       @unique
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod String?
  status        PaymentStatus @default(PENDING)
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  donation Donation @relation("DonationPayment", fields: [donationId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Distribution {
  id           String             @id @default(cuid())
  programId    String
  amount       Decimal            @db.Decimal(12, 2)
  title        String
  description  String             @db.Text
  receiptImage String?
  status       DistributionStatus @default(PENDING)
  createdById  String
  approvedById String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  program    Program @relation("ProgramDistributions", fields: [programId], references: [id], onDelete: Restrict)
  createdBy  User    @relation("DistributionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User?   @relation("DistributionApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@map("distributions")
}
