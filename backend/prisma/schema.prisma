generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                String                 @id @default(cuid())
  email                             String                 @unique
  name                              String?
  password                          String?
  avatarUrl                         String?
  emailVerified                     DateTime?
  status                            UserStatus             @default(ACTIVE)
  lastLoginAt                       DateTime?
  roleId                            String
  lembagaId                         String?
  isPlatformAdmin                   Boolean                @default(false)
  createdAt                         DateTime               @default(now())
  updatedAt                         DateTime               @updatedAt
  avatarPublicId                    String?
  emailNotifications                Boolean                @default(true)
  phoneNumber                       String?
  waNotifications                   Boolean                @default(true)
  auditLogs                         AuditLog[]
  distributionsApproved             Distribution[]         @relation("DistributionApprover")
  distributionsCreated              Distribution[]         @relation("DistributionCreator")
  programs                          Program[]
  programApprovals                  Program[]              @relation("ProgramApprover")
  lembaga                           Lembaga?               @relation(fields: [lembagaId], references: [id], onDelete: Cascade)
  role                              Role                   @relation(fields: [roleId], references: [id])
  lembagaApprovals                  Lembaga[]              @relation("LembagaApprover")
  volunteerApplicationReviews       VolunteerApplication[] @relation("VolunteerApplicationReviewer")
  volunteerApplicationVerifications VolunteerApplication[] @relation("VolunteerApplicationVerifier")
  volunteerActivitiesCreated        VolunteerActivity[]    @relation("VolunteerActivityCreator")

  @@map("users")
}

model Lembaga {
  id                    String                 @id @default(cuid())
  name                  String
  slug                  String                 @unique
  logoUrl               String?
  logoPublicId          String?
  status                LembagaStatus          @default(PENDING)
  rejectionReason       String?
  approvedAt            DateTime?
  approvedById          String?
  picName               String                 @default("")
  picPhone              String?
  address               String                 @default("")
  description           String?
  officePhotoUrl        String?
  officePhotoPublicId   String?
  website               String?
  izinYayasanNumber     String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  auditLogs             AuditLog[]
  distributions         Distribution[]
  donations             Donation[]
  payments              Payment[]
  programs              Program[]
  users                 User[]
  documents             LembagaDocument[]
  volunteerApplications VolunteerApplication[]
  volunteerActivities   VolunteerActivity[]
  approvedBy            User?                  @relation("LembagaApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@map("lembagas")
}

model LembagaDocument {
  id           String              @id @default(cuid())
  lembagaId    String
  type         LembagaDocumentType
  fileUrl      String
  filePublicId String?
  originalName String?
  createdAt    DateTime            @default(now())
  lembaga      Lembaga             @relation(fields: [lembagaId], references: [id], onDelete: Cascade)

  @@map("lembaga_documents")
}

enum LembagaStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LembagaDocumentType {
  AKTA_YAYASAN
  SK_KEMENKUMHAM
  NPWP
  OTHER
}

model Role {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  users           User[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(cuid())
  key             String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  lembagaId String?
  action    AuditAction
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())
  lembaga   Lembaga?    @relation(fields: [lembagaId], references: [id])
  user      User?       @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Program {
  id                  String              @id @default(cuid())
  lembagaId           String
  createdById         String
  title               String
  slug                String
  description         String
  targetAmount        Decimal             @db.Decimal(12, 2)
  currentAmount       Decimal             @default(0) @db.Decimal(12, 2)
  distributedAmount   Decimal             @default(0) @db.Decimal(12, 2)
  category            ProgramCategory
  status              ProgramStatus       @default(DRAFT)
  rejectionReason     String?
  approvedAt          DateTime?
  approvedById        String?
  imageUrl            String?
  startDate           DateTime?
  endDate             DateTime?
  isFeatured          Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  distributions       Distribution[]
  donations           Donation[]
  createdBy           User                @relation(fields: [createdById], references: [id])
  approvedBy          User?               @relation("ProgramApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  lembaga             Lembaga             @relation(fields: [lembagaId], references: [id], onDelete: Cascade)
  volunteerActivities VolunteerActivity[]

  @@unique([lembagaId, slug])
  @@map("programs")
}

model Donation {
  id          String         @id @default(cuid())
  lembagaId   String
  programId   String
  donorName   String?
  donorEmail  String?
  donorPhone  String?
  amount      Decimal        @db.Decimal(12, 2)
  message     String?
  isAnonymous Boolean        @default(false)
  status      DonationStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  lembaga     Lembaga        @relation(fields: [lembagaId], references: [id], onDelete: Cascade)
  program     Program        @relation(fields: [programId], references: [id])
  payment     Payment?

  @@index([donorPhone])
  @@map("donations")
}

model Payment {
  id            String        @id @default(cuid())
  lembagaId     String
  donationId    String        @unique
  gatewayRef    String?       @unique
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod String?
  status        PaymentStatus @default(PENDING)
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  donation      Donation      @relation(fields: [donationId], references: [id], onDelete: Cascade)
  lembaga       Lembaga       @relation(fields: [lembagaId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Distribution {
  id              String             @id @default(cuid())
  lembagaId       String
  programId       String
  createdById     String
  approvedById    String?
  amount          Decimal            @db.Decimal(12, 2)
  title           String
  description     String
  receiptImageUrl String?
  status          DistributionStatus @default(PENDING)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  approvedBy      User?              @relation("DistributionApprover", fields: [approvedById], references: [id])
  createdBy       User               @relation("DistributionCreator", fields: [createdById], references: [id])
  lembaga         Lembaga            @relation(fields: [lembagaId], references: [id], onDelete: Cascade)
  program         Program            @relation(fields: [programId], references: [id])

  @@map("distributions")
}

model Volunteer {
  id            String                 @id @default(cuid())
  name          String
  email         String                 @unique
  password      String
  phone         String
  address       String?
  photoUrl      String?
  photoPublicId String?
  ktpUrl        String?
  ktpPublicId   String?
  cvUrl         String?
  cvPublicId    String?
  status        VolunteerStatus        @default(ACTIVE)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  applications  VolunteerApplication[]

  @@map("volunteers")
}

/// Kegiatan relawan dibuat oleh Lembaga — entitas mandiri (opsional terhubung
/// ke satu Program) yang dilamar relawan, bukan program donasi itu sendiri.
model VolunteerActivity {
  id           String                  @id @default(cuid())
  lembagaId    String
  programId    String?
  createdById  String
  title        String
  description  String
  location     String?
  activityDate DateTime?
  quota        Int?
  status       VolunteerActivityStatus @default(OPEN)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  lembaga      Lembaga                @relation(fields: [lembagaId], references: [id], onDelete: Cascade)
  program      Program?               @relation(fields: [programId], references: [id], onDelete: SetNull)
  createdBy    User                   @relation("VolunteerActivityCreator", fields: [createdById], references: [id])
  applications VolunteerApplication[]

  @@map("volunteer_activities")
}

model VolunteerApplication {
  id                 String                     @id @default(cuid())
  volunteerId        String
  activityId         String
  lembagaId          String
  status             VolunteerApplicationStatus @default(PENDING)
  rejectionReason    String?
  reviewedById       String?
  reviewedAt         DateTime?
  reportText         String?
  reportFileUrl      String?
  reportFilePublicId String?
  reportSubmittedAt  DateTime?
  reportNote         String?
  verifiedById       String?
  verifiedAt         DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  volunteer          Volunteer                  @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  activity           VolunteerActivity          @relation(fields: [activityId], references: [id], onDelete: Cascade)
  lembaga            Lembaga                    @relation(fields: [lembagaId], references: [id], onDelete: Cascade)
  reviewedBy         User?                      @relation("VolunteerApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  verifiedBy         User?                      @relation("VolunteerApplicationVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@unique([volunteerId, activityId])
  @@map("volunteer_applications")
}

enum VolunteerStatus {
  ACTIVE
  SUSPENDED
}

enum VolunteerActivityStatus {
  OPEN
  CLOSED
  CANCELLED
}

/// Alur: PENDING -> APPROVED/REJECTED -> (APPROVED) relawan ikut kegiatan
/// -> REPORT_SUBMITTED (relawan submit laporan) -> COMPLETED (lembaga verifikasi).
enum VolunteerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  REPORT_SUBMITTED
  COMPLETED
}

/// Server-side session store for express-session (connect-pg-simple).
/// Managed by the session middleware; mirrored here so Prisma migrate
/// does not flag the table as drift.
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum DonationStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  EXPIRED
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  ROLE_CHANGE
  PAYMENT_UPDATE
  DISTRIBUTION_UPDATE
  LEMBAGA_APPROVE
  LEMBAGA_REJECT
  PROGRAM_APPROVE
  PROGRAM_REJECT
  VOLUNTEER_APPLICATION_REVIEW
  VOLUNTEER_REPORT_SUBMIT
  VOLUNTEER_REPORT_VERIFY
}

enum ProgramCategory {
  ZAKAT
  INFAK
  SEDEKAH
  WAKAF
}

enum ProgramStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  COMPLETED
  CANCELLED
}

enum DistributionStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}
