# Environment example for LAZ Platform backend (NestJS)
# -------------------------------------------------
NODE_ENV="development"
PORT=4000

# Database
DATABASE_URL="postgresql://<USER>@<HOST>:<PORT>/<DB_NAME>?schema=public"

# Session & CSRF secrets — REQUIRED, app crashes on boot if missing
SESSION_SECRET="<RANDOM_64_CHARS>"
CSRF_SECRET="<RANDOM_64_CHARS>"

# CORS allowlist (comma-separated origins) — Vite dev server by default
CORS_ORIGIN="http://localhost:5173"

# Xendit payment gateway credentials
# XENDIT_SECRET_KEY — Secret API key from Xendit Dashboard > Settings > Developers > API Keys
# Use Development key for test mode, Live key for production
XENDIT_SECRET_KEY="xnd_development_<YOUR_SECRET_KEY>"

# XENDIT_WEBHOOK_TOKEN — Verification token from Xendit Dashboard > Settings > Developers > Webhooks
# Used to verify authenticity of incoming webhook calls via x-callback-token header
# Current payment creation uses Payments API v2 (xendit-node PaymentRequest).
# Register Payment Succeeded and Payment Failed callbacks under Payment Request:
# https://<BACKEND_DOMAIN>/api/webhooks/xendit/payment
# Handler accepts v2 payment.succeeded/payment.failed and v3 payment.capture/payment.failure.
# Payment Method expiry events do not represent a failed payment and are ignored.
XENDIT_WEBHOOK_TOKEN="<YOUR_WEBHOOK_VERIFICATION_TOKEN>"

# Cloudinary credentials
CLOUDINARY_CLOUD_NAME="<YOUR_CLOUD_NAME>"
CLOUDINARY_API_KEY="<YOUR_API_KEY>"
CLOUDINARY_API_SECRET="<YOUR_API_SECRET>"

# Seed admin credentials (development only)
SEED_ADMIN_EMAIL="admin-dev@laz.id"
SEED_ADMIN_PASSWORD="DevAdmin@123"
SEED_FINANCE_EMAIL="finance@ruangberbagi.id"
SEED_FINANCE_PASSWORD="Finance@123456"

# Optional
LOG_LEVEL="debug"

# WhatsApp Super Admin untuk tindak lanjut pendaftaran Lembaga yang ditolak.
# Isi nomor internasional tanpa +, spasi, atau tanda hubung (contoh: 6281234567890).
# Kosongkan untuk menonaktifkan tombol WhatsApp. Restart backend setelah mengubah.
SUPER_ADMIN_WHATSAPP_NUMBER="6285156895256"
